{
  "name": "kostops",
  "version": "3.0.0",
  "description": "Self-hosted AWS FinOps agent — cost visibility and optimization on Bedrock AgentCore",
  "private": true,
  "scripts": {
    "build":   "tsc",
    "watch":   "tsc -w",
    "cdk":     "cdk",
    "deploy":  "cdk deploy --all",
    "destroy": "cdk destroy --all"
  },
  "dependencies": {
    "aws-cdk-lib":          "^2.180.0",
    "constructs":           "^10.0.0",
    "source-map-support":   "^0.5.21"
  },
  "devDependencies": {
    "@types/node":  "^22.0.0",
    "ts-node":      "^10.9.2",
    "typescript":   "^5.7.2"
  }
}
